{
  "description": "邗上课表微信小程序（网页版 PWA 的原生移植）",
  "projectname": "hanshang-miniprogram",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "autoAudits": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "ignoreUploadUnusedFiles": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tools" },
      { "type": "file", "value": "README.md" }
    ]
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  }
}
