<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 网络访问：登录、同步、检查更新 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 上课提醒：Android 13+ 通知权限 / 重启后重挂闹钟 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- AI 日程语音输入（2.0 新增；按住说话时申请，privacy-v4 已披露） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 上课提醒按点送达：Android 12+ 声明,Android 14+ 需在系统设置中授权
         「闹钟和提醒」;未授权时自动降级为不精确闹钟(可能延迟几分钟)。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- 文件导入使用 ACTION_OPEN_DOCUMENT 的一次性 URI 授权。部分第三方 SDK
         仍声明旧存储权限，必须在最终合并清单中显式移除。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- 2026-09-02 合规：手表 BLE 功能未发布，移除蓝牙/定位权限声明，
         与隐私政策「不索取定位权限」保持一致；功能上线时再补回。 -->
    <application
        android:label="邗上课表"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:resizeableActivity="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:allowBackup,android:label">
        <!-- 正式构建的 network-security-config 全局拒绝明文流量。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- 上课提醒：重启后清理旧版（自研链路）遗留闹钟，新提醒由插件链路负责 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name=".NotificationReceiver"
            android:exported="false" />
        <!-- flutter_local_notifications 的定时/动作/开机恢复接收器（review R19）：
             插件 18.x 的 manifest 不代为声明，缺了它们 zonedSchedule 到点后
             无广播目标，定时提醒永远不响。开机恢复也统一交给插件
             （ScheduledNotificationBootReceiver），与 cancel/cancelAll 使用
             同一套 PendingIntent，能被正确取消。 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />
        <receiver
            android:name="com.aliyun.ams.push.AliyunPushMessageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.alibaba.push2.action.NOTIFICATION_OPENED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.alibaba.push2.action.NOTIFICATION_REMOVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.alibaba.sdk.android.push.RECEIVE" />
            </intent-filter>
        </receiver>
        <!-- 今日课程桌面小组件 -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false"
            android:label="今日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <!-- 日视图桌面小组件 -->
        <receiver
            android:name=".DayWidgetProvider"
            android:exported="false"
            android:label="日视图">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>
        <!-- 日视图（大）桌面小组件：4x4，满课日显示更多行 -->
        <receiver
            android:name=".DayLargeWidgetProvider"
            android:exported="false"
            android:label="日视图（大）">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_large_info" />
        </receiver>
        <!-- 一周课程桌面小组件 -->
        <receiver
            android:name=".WeekWidgetProvider"
            android:exported="false"
            android:label="一周课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <!-- 近日课程桌面小组件 -->
        <receiver
            android:name=".TwoDayWidgetProvider"
            android:exported="false"
            android:label="近日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/twoday_widget_info" />
        </receiver>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 拍照识别：相机 Intent 经 FileProvider 取全尺寸照片（不声明相机权限） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher 打开 APK 下载链接（浏览器）-->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
